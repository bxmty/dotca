{
  "name": "dotca",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_COMMIT_HASH=$(node get-commit-hash.js) next dev -H 0.0.0.0",
    "build": "NEXT_PUBLIC_COMMIT_HASH=$(node get-commit-hash.js) next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --testFailureExitCode=0",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "pre-commit:install": "pre-commit install",
    "pre-commit:run": "pre-commit run --all-files"
  },
  "dependencies": {
    "@sentry/nextjs": "10.70.0",
    "@stripe/react-stripe-js": "6.8.2",
    "@stripe/stripe-js": "9.14.0",
    "bootstrap": "5.3.8",
    "js-yaml": "5.3.0",
    "libphonenumber-js": "1.13.11",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-phone-input-2": "2.15.1",
    "remark-gfm": "4.0.1",
    "resend": "6.22.0",
    "stripe": "22.5.0",
    "web-vitals": "6.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "js-yaml": "5.3.0"
  }
}

# Copy to .env.local and fill in real values. .env.local is gitignored;
# this file is the committed reference — never put real secrets in it.
#
# Local dev uses Stripe TEST-mode keys. Note there are no price IDs here:
# Prices are resolved at runtime by lookup_key, so STRIPE_SECRET_KEY being
# an sk_test_ key is the only thing that selects test-mode pricing.
# See tasks/prd-paid-checkout-and-email-redundancy.md §3.1.

# --- DigitalOcean API access (deploys from your machine only) ---
# https://cloud.digitalocean.com/account/api/tokens
DO_TOKEN=your_digitalocean_api_token_here

# SSH configuration (uses SSH agent)
# Optional: specify if you have multiple SSH keys
SSH_KEY_FINGERPRINT=

# --- Brevo (contact/onboarding CRM writes) ---
BREVO_API_KEY=your_brevo_api_key_here

# --- Stripe (test mode: sk_test_... / pk_test_...) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — printed by `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` on each run. NOT the dashboard value.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (email redundancy) ---
RESEND_API_KEY=re_...
# boximity.ca is verified in Resend (DKIM/SPF landed 2026-07-12), so use
# the real sender; onboarding@resend.dev is only needed on a fresh account.
RESEND_FROM_EMAIL=noreply@boximity.ca
WEBMASTER_EMAIL=hi@boximity.ca

# --- Lead magnets ---
# HMAC key for the 24-hour signed download links (/api/lead-magnet/download).
# Server-only runtime env var. It must be at least 32 characters: anything
# shorter (or unset) makes the lead-magnet routes answer 503. Generate one with
#   openssl rand -hex 32
# and paste the 64-character output here. Rotating it invalidates every
# outstanding link. Deploys warn when it is missing, except production, which
# refuses to deploy (scripts/check-lead-magnet-secret.sh).
LEAD_MAGNET_SIGNING_SECRET=

# --- Free-tier agent installer ---
# Target of the boximity.ca/install redirect: the Syncro agent installer link
# for the shared "Free tier" customer (never a paying customer's folder).
# Server-only runtime env var. Optional: when unset or not an absolute http(s)
# URL, /install responds 503. Rotate it (and redeploy) if unknown devices
# enroll. Treat it like a secret: anyone with it can enroll a device.
SYNCRO_FREE_INSTALLER_URL=

# --- Syncro (website leads; later the joiner/leaver intake, #565) ---
# Subdomain of the Syncro account: https://<SYNCRO_SUBDOMAIN>.syncromsp.com
# Server-only runtime env vars. Optional: when either is unset, Syncro reads
# as unreachable and leads reach the webmaster email only.
SYNCRO_SUBDOMAIN=your_syncro_subdomain
SYNCRO_API_KEY=your_syncro_api_key_here

# --- Monthly security brief opt-in (Resend contacts) ---
# A ticked opt-in box on the contact, onboarding or checkout form makes the
# submitter a Resend contact in this segment, opted in to this topic (both
# named "Monthly security brief" in Resend; copy the IDs from the dashboard).
# Server-only runtime env vars. Optional: when either is unset, opted-in
# submissions still succeed but skip Resend with a Sentry warning. Contact
# writes need a full-access RESEND_API_KEY, not a sending-only one.
RESEND_MONTHLY_BRIEF_SEGMENT_ID=segment-uuid-from-resend
RESEND_MONTHLY_BRIEF_TOPIC_ID=topic-uuid-from-resend
# After the contact write, one Resend event with this name (payload
# { source: "contact" | "onboarding" | "checkout" }) starts the nurture
# automation. lead.opted_in in production, lead.opted_in.staging in staging
# (one Resend account serves both, so staging must never fire the production
# automation). Optional: when unset, opt-ins still subscribe but send no
# event, with a Sentry warning.
RESEND_OPTIN_EVENT=lead.opted_in.staging
# Manual Resend setup, no env var: the Stripe webhook sets contact property
# `customer` to "paid" on an existing contact when an invoice is paid, so the
# nurture skips its upsell. Create a string contact property named `customer`
# (no fallback) in the Resend dashboard first; until it exists, expect the
# update to fail with a Sentry warning (the webhook still succeeds).

# --- Day-0 confirmation emails (Resend templates) ---
# Every successful contact / onboarding submission gets one confirmation
# email from a published Resend template (from "Boximity <RESEND_FROM_EMAIL>",
# reply-to hi@boximity.ca), opted in or not. Copy the template IDs from the
# Resend dashboard; staging and production share the same templates.
# Server-only runtime env vars. Optional: when unset, submissions still
# succeed but send no confirmation, with a Sentry warning.
RESEND_TEMPLATE_CONTACT_CONFIRMATION=template-id-from-resend
RESEND_TEMPLATE_ONBOARDING_CONFIRMATION=template-id-from-resend

# --- Google Analytics ---
GA_STAGING_ID=G-XXXXXXXXXX
GA_PRODUCTION_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol API secret — runtime env var written by Ansible at
# deploy time, NOT a NEXT_PUBLIC_* build arg (that would inline it into the
# client bundle). One secret per GA4 property: staging and production use
# different values. Create in GA4 Admin -> Data streams -> [stream] ->
# Measurement Protocol API secrets.
GA4_MP_API_SECRET=your_ga4_mp_api_secret_here

# --- Local deploys only (just deploy / scripts/local-deploy.sh) ---
# GitHub PAT with read:packages, used on the droplet to pull from ghcr.io.
# The deploy playbooks fail if this is empty.
# GITHUB_TOKEN=ghp_...

# --- Optional overrides ---
# DOCKER_IMAGE=ghcr.io/yourusername/dotca:custom-tag

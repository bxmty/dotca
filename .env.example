# Copy to .env.local and fill in real values. .env.local is gitignored;
# this file is the committed reference — never put real secrets in it.
#
# Local dev uses Stripe TEST-mode values throughout. Live-mode values exist
# only in the GitHub `production` environment secrets (see
# tasks/prd-paid-checkout-and-email-redundancy.md §9.2).

# --- DigitalOcean API access (deploys from your machine only) ---
# https://cloud.digitalocean.com/account/api/tokens
DO_TOKEN=your_digitalocean_api_token_here

# SSH configuration (uses SSH agent)
# Optional: specify if you have multiple SSH keys
SSH_KEY_FINGERPRINT=

# --- Brevo (contact/onboarding CRM writes) ---
BREVO_API_KEY=your_brevo_api_key_here

# --- Stripe (test mode: sk_test_... / pk_test_...) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — printed by `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` on each run. NOT the dashboard value.
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs (test mode) — created per §3.1 of the PRD, all CAD, per-seat
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# --- Resend (email redundancy) ---
RESEND_API_KEY=re_...
# Use onboarding@resend.dev until boximity.ca DKIM/SPF verification lands,
# then switch to noreply@boximity.ca
RESEND_FROM_EMAIL=onboarding@resend.dev
WEBMASTER_EMAIL=hi@boximity.ca

# --- Google Analytics ---
GA_STAGING_ID=G-XXXXXXXXXX
GA_PRODUCTION_ID=G-XXXXXXXXXX

# --- Optional overrides ---
# DOCKER_IMAGE=ghcr.io/yourusername/dotca:custom-tag
# ANSIBLE_VAULT_PASSWORD=your_vault_password_if_using_encrypted_vars

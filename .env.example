# Copy to .env.local and fill in real values. .env.local is gitignored;
# this file is the committed reference — never put real secrets in it.
#
# Local dev uses Stripe TEST-mode keys. Note there are no price IDs here:
# Prices are resolved at runtime by lookup_key, so STRIPE_SECRET_KEY being
# an sk_test_ key is the only thing that selects test-mode pricing.
# See tasks/prd-paid-checkout-and-email-redundancy.md §3.1.

# --- DigitalOcean API access (deploys from your machine only) ---
# https://cloud.digitalocean.com/account/api/tokens
DO_TOKEN=your_digitalocean_api_token_here

# SSH configuration (uses SSH agent)
# Optional: specify if you have multiple SSH keys
SSH_KEY_FINGERPRINT=

# --- Brevo (contact/onboarding CRM writes) ---
BREVO_API_KEY=your_brevo_api_key_here

# --- Stripe (test mode: sk_test_... / pk_test_...) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — printed by `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` on each run. NOT the dashboard value.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (email redundancy) ---
RESEND_API_KEY=re_...
# boximity.ca is verified in Resend (DKIM/SPF landed 2026-07-12), so use
# the real sender; onboarding@resend.dev is only needed on a fresh account.
RESEND_FROM_EMAIL=noreply@boximity.ca
WEBMASTER_EMAIL=hi@boximity.ca

# --- Google Analytics ---
GA_STAGING_ID=G-XXXXXXXXXX
GA_PRODUCTION_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol API secret — runtime env var written by Ansible at
# deploy time, NOT a NEXT_PUBLIC_* build arg (that would inline it into the
# client bundle). One secret per GA4 property: staging and production use
# different values. Create in GA4 Admin -> Data streams -> [stream] ->
# Measurement Protocol API secrets.
GA4_MP_API_SECRET=your_ga4_mp_api_secret_here

# --- Local deploys only (just deploy / scripts/local-deploy.sh) ---
# GitHub PAT with read:packages, used on the droplet to pull from ghcr.io.
# The deploy playbooks fail if this is empty.
# GITHUB_TOKEN=ghp_...

# --- Optional overrides ---
# DOCKER_IMAGE=ghcr.io/yourusername/dotca:custom-tag

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "baseBranchPatterns": ["staging"],
  "schedule": ["at any time"],
  "timezone": "America/New_York",
  "constraints": {
    "npm": "11.21.1"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Friday"]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "enabled": true
    }
  ]
}

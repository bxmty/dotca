{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "baseBranchPatterns": ["staging"],
  "schedule": ["at any time"],
  "timezone": "America/New_York",
  "constraints": {
    "npm": "12.2.1"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Friday"]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "enabled": true
    },
    {
      "description": "One PR (one staging deploy) for all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Payments: own PR so checkout changes get their own review",
      "matchPackageNames": ["stripe", "@stripe/**"],
      "groupName": "stripe",
      "schedule": ["before 6am on monday"]
    }
  ]
}
